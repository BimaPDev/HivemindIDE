	"tokenColors": [
		{
			"name": "Comment",
			"scope": [
				"comment",
				"punctuation.definition.comment",
				"string.comment"
			],
			"settings": {
				"foreground": "#a6a6a6",
				"fontStyle": "italic"
			}
		},
		{
			"name": "Keyword",
			"scope": [
				"keyword",
				"storage",
				"storage.type",
				"storage.modifier",
				"keyword.other.using",
				"keyword.other.operator"
			],
			"settings": {
				"foreground": "#7a3cc8",
				"fontStyle": ""
			}
		},
		{
			"name": "Control flow",
			"scope": [
				"keyword.control",
				"keyword.control.flow",
				"keyword.control.conditional",
				"keyword.control.loop",
				"keyword.control.trycatch"
			],
			"settings": {
				"foreground": "#c8321f",
				"fontStyle": ""
			}
		},
		{
			"name": "Import",
			"scope": [
				"keyword.control.import",
				"keyword.control.export",
				"keyword.control.from",
				"keyword.control.default",
				"keyword.control.as",
				"keyword.other.import",
				"keyword.import",
				"keyword.package",
				"keyword.other.package",
				"keyword.control.module",
				"keyword.other.use",
				"keyword.other.crate"
			],
			"settings": {
				"foreground": "#9a4fd6",
				"fontStyle": ""
			}
		},
		{
			"name": "Operator",
			"scope": [
				"keyword.operator",
				"punctuation.accessor",
				"punctuation.separator.key-value"
			],
			"settings": {
				"foreground": "#2e7fa8"
			}
		},
		{
			"name": "Keyword operators",
			"scope": [
				"keyword.operator.new",
				"keyword.operator.expression",
				"keyword.operator.logical.python",
				"keyword.operator.wordlike",
				"keyword.operator.instanceof",
				"keyword.operator.typeof"
			],
			"settings": {
				"foreground": "#c8321f"
			}
		},
		{
			"name": "String",
			"scope": [
				"string",
				"string.quoted",
				"string.template",
				"string.unquoted",
				"markup.inline.raw",
				"markup.fenced_code"
			],
			"settings": {
				"foreground": "#3f7a12"
			}
		},
		{
			"name": "Template expression",
